{
  "name": "qase-app",
  "version": "1.0.5",
  "type": "module",
  "description": "Qase.io Desktop App",
  "main": "main.js",
  "author": {
    "name": "Rodz",
    "email": "6975563+digoo@users.noreply.github.com"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:ci": "electron-builder --publish=never",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.qase.app",
    "productName": "Qase",
    "publish": {
      "provider": "github"
    },
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "keywords": [
    "qase",
    "desktop",
    "app",
    "test",
    "management"
  ],
  "license": "ISC",
  "dependencies": {
    "electron-chrome-extensions": "^4.9.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.7.3"
  }
}
